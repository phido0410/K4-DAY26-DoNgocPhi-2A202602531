# Environment Variables Configuration
# Copy this file to .env and fill in your actual API keys:
# cp .env.example .env

# 1. Google Gemini API Key (dùng cho 01-function-calling và 04-lab/mcp-client)
# Lấy miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# 2. WeatherAPI Key (dùng cho 04-lab/mcp-server)
# Đăng ký miễn phí tại: https://weatherapi.com
WEATHERAPI_KEY=your_weatherapi_key_here

